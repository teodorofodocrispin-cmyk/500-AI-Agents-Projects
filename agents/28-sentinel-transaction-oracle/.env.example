# SENTINEL Transaction Safety Oracle — environment variables
# Copy to .env and fill real values. Never commit a real key.

# Optional: override the API base (defaults to https://sentinel-agent.dev)
SENTINEL_API_BASE=https://sentinel-agent.dev

# x402 payment payload (base64 PAYMENT-SIGNATURE) produced by an x402 client
# such as agentcash or x402-fetch. SENTINEL has no free tier: without it the
# agent fails closed (verdict UNKNOWN, safe_to_sign false).
SENTINEL_PAYMENT=
